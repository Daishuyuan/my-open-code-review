{
  "name": "my-open-code-review",
  "version": "0.0.0",
  "description": "OpenCodeReview CLI — AI-powered code review tool",
  "bin": {
    "ocr": "bin/ocr.js"
  },
  "files": [
    "bin/ocr.js",
    "scripts/install.js",
    "scripts/update.js",
    "scripts/platform.js",
    "imgs/"
  ],
  "scripts": {
    "build": "go build -o dist/opencodereview ./cmd/opencodereview",
    "test": "go test ./...",
    "postinstall": "node scripts/install.js",
    "test:github-actions": "node scripts/github-actions/post-review-comments.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daishuyuan/my-open-code-review.git"
  },
  "homepage": "https://github.com/Daishuyuan/my-open-code-review",
  "bugs": {
    "url": "https://github.com/Daishuyuan/my-open-code-review/issues"
  },
  "ocrConfig": {
    "releaseRepo": "Daishuyuan/my-open-code-review",
    "assetPattern": "opencodereview-{os}-{arch}",
    "platformPackagePrefix": "my-open-code-review-ocr",
    "urlPattern": "https://github.com/Daishuyuan/my-open-code-review/releases/download/v{version}/opencodereview-{os}-{arch}",
    "checksumPattern": "https://github.com/Daishuyuan/my-open-code-review/releases/download/v{version}/sha256sum.txt"
  },
  "optionalDependencies": {
    "my-open-code-review-ocr-darwin-arm64": "0.0.0",
    "my-open-code-review-ocr-darwin-x64": "0.0.0",
    "my-open-code-review-ocr-linux-arm64": "0.0.0",
    "my-open-code-review-ocr-linux-x64": "0.0.0",
    "my-open-code-review-ocr-win32-arm64": "0.0.0",
    "my-open-code-review-ocr-win32-x64": "0.0.0"
  },
  "engines": {
    "node": ">=14"
  },
  "license": "Apache-2.0"
}
